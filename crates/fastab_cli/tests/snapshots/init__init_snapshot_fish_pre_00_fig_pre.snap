---
source: crates/ec_cli/tests/init.rs
assertion_line: 107
expression: init
---
set -g Q_SHELL "/bin/zsh"
set -g SHOULD_QTERM_LAUNCH "0"
test -d ~/.local/bin; or command mkdir -p ~/.local/bin >/dev/null

builtin contains $HOME/.local/bin $PATH
or set --append PATH $HOME/.local/bin

if not test -z "$Q_NEW_SESSION"
    set --erase QTERM_SESSION_ID
    set --erase Q_TERM
    set --erase Q_NEW_SESSION
end

# Load parent from env variables (same logic as pre.sh)
if test -z "$Q_SET_PARENT_CHECK"
    if test -z "$Q_PARENT"; and test -n "$Q_SET_PARENT"
        set --export Q_PARENT $Q_SET_PARENT
        set --erase Q_SET_PARENT
    end
    set --export Q_SET_PARENT_CHECK 1
end

if test -z "$SHOULD_QTERM_LAUNCH"
    # 0 = Yes, 1 = No, 2 = Fallback to Q_TERM
    ftab _ should-figterm-launch 1>/dev/null 2>&1
    set SHOULD_QTERM_LAUNCH $status
end

# Use the PTY shipped beside Fastab, while retaining explicit overrides.
set -e _FASTAB_DEFAULT_PTY_PATH
if not set -q Q_TERM_PATH
    set Q_TERM_PATH '/Applications/Fastab.app/Contents/MacOS/fterm'
    set _FASTAB_DEFAULT_PTY_PATH 1
else if not string match -q '*/*' -- "$Q_TERM_PATH"
    # Only explicit overrides may resolve a development binary through PATH.
    set Q_TERM_PATH (command -v -- "$Q_TERM_PATH")
end

if test -t 1
    and test -z "$PROCESS_LAUNCHED_BY_Q"
    and test -x "$Q_TERM_PATH"
    and test "$SHOULD_QTERM_LAUNCH" -eq 0 -o \( "$SHOULD_QTERM_LAUNCH" -eq 2 -a \( -z "$Q_TERM" -o \( -z "$Q_TERM_TMUX" -a -n "$TMUX" \) \) \)

    if test -z "$Q_SHELL"
        set Q_SHELL (ftab _ get-shell)
    end
    set Q_IS_LOGIN_SHELL 0
    if status --is-login
        set Q_IS_LOGIN_SHELL 1
    end

    # Do not launch fterm in non-interactive shells (like VSCode Tasks)
    if status --is-interactive
        set Q_TERM_NAME (command basename "$Q_SHELL")" (fterm)"
        if set -q _FASTAB_DEFAULT_PTY_PATH; and test -x "$HOME/.local/bin/$Q_TERM_NAME"
            set Q_TERM_PATH "$HOME/.local/bin/$Q_TERM_NAME"
        end
        set -e _FASTAB_DEFAULT_PTY_PATH

        # Need to exec bash because we're using 'exec -a <name>'
        # to set argv[0] and fish's exec doesn't have this option
        exec bash -c 'Q_PARENT="$1" Q_SHELL="$2" Q_IS_LOGIN_SHELL="$3" exec -a "$4" "$5"' -- "$Q_PARENT" "$Q_SHELL" "$Q_IS_LOGIN_SHELL" "$Q_TERM_NAME" "$Q_TERM_PATH"
    end
end
set -e _FASTAB_DEFAULT_PTY_PATH
